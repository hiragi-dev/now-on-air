{
    "name": "NowOnAir",
    "options_page": "options.html",
    "version": "1.0.0",
    "manifest_version": 3,
    "description": "昔のアニメをリアタイ化する拡張機能",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://tv.dmm.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_title": "タイトルとURLをコピー",
        "default_popup": "popup.html"
    }
}